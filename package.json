{
  "name": "insanity-loom",
  "productName": "Insanity_Loom",
  "desktopName": "insanity-loom.desktop",
  "version": "0.0.1",
  "description": "A text editor for one author and an AI assistant, working in the same document.",
  "author": "CatDev0342",
  "license": "Apache-2.0",
  "homepage": "https://github.com/CatDev0342/Insanity_Loom",
  "repository": {
    "type": "git",
    "url": "https://github.com/CatDev0342/Insanity_Loom.git"
  },
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "licenses": "node scripts/check-licenses.mjs",
    "dist": "npm run licenses && npm run build && electron-builder --publish never",
    "check": "npm run typecheck && npm run lint && npm run test && npm run licenses"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "5.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller": false
  }
}
